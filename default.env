# =============================================================================
# XDC Docker - Default Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment.
# Variables ending in _TAG, _REPO, or _DOCKERFILE are "build targets"
# that get reset during updates when --refresh-targets is used.
# =============================================================================

# Compose files to use (colon-separated)
# Add :ext-network.yml for Traefik/Prometheus integration
# Add :rpc-shared.yml to expose RPC ports locally
COMPOSE_FILE=xdc.yml

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# XDC network (mainnet or testnet)
# Network ID is auto-derived: mainnet=50, testnet=51
NETWORK=mainnet

# =============================================================================
# DOCKER IMAGES
# =============================================================================

# XDC XDPoS Chain image
# Releases: https://github.com/XinFinOrg/XinFin-Node/releases
NODE_DOCKER_REPO=xinfinorg/xdposchain
NODE_DOCKER_TAG=v2.7.0

# =============================================================================
# DATA STORAGE
# =============================================================================

# Genesis JSON URL (required for first initialization)
GENESIS_URL=https://raw.githubusercontent.com/XinFinOrg/XinFin-Node/master/mainnet/genesis.json

# Snapshot URL for faster initial sync (leave empty to sync from genesis)
# Set to https://download.xinfin.network/xdcchain.tar for ~650GB snapshot
SNAPSHOT_URL=

# XDC bootnodes (comma-separated enode:// URLs)
XDC_BOOTNODES=enode://3891870345e3ab00b15bc2aed0bac26ccb225adb06e7b3a4009a8f6cfee27f82a02fc188cc6553b2f070498a9f4148aa5ebade901a290b340eb25dec70705762@38.49.209.153:30303,enode://5b7653e7acdab863312bbed7a03898f53d877ccf0d4e77c90655e518e5b733ad478331f203a2cabde0c32c7dfdc007f4a907a7e9a6fcabc25d3b9bbe85a06018@144.126.142.140:30303,enode://eb60740254a78a8585a6ff11d05d9db519e92c8eabf77c842890451c29f2a4a6cffd45a162fd6ce0151f0d7e51e2535a1ba46f8ea7b02cf07ac48bb352843992@38.49.209.215:30303,enode://8972335640e8b675ed135b16b80dfbdf905d56f64dc3bce4f23d0262ded4cde74139f26805def8cf96a574e042f3c937148b2cdc843b6c9a806d3a91a202c7db@104.152.211.94:30303,enode://7cfd60b97998326609b7cf0c984a458faf84edeaa85f3cec75a4e8c3df871c44f33ce00da644ec26b9cf911d1d48bfea797c2df3e3e3ca9abad75f9ff6602637@65.109.25.162:30303,enode://053ba696174e7f115e38f0e3963d0035ac20dc18e9a5c5873f9e90fe338d777f726d68d053c987416ec0bd97d4d818c59a8a23bc9ea854069ea2310846e27e7d@162.250.189.221:30303,enode://938f2e3f409a12573e6da6460b6497c45e2bec393756b989b8874f647911cca39d0ffef8554a45698a8f21a7e870288beb638b3770537a12118e30bd6f9ae806@109.199.104.176:30303,enode://b9d448697d4f9d1f3ec64162c61fbc171fc9888137c024206fac04411c93edff4d4fc5079b16d92d83ecce0cf4866f0f118fc56dfa171436a3919c6eb45dde4f@207.180.240.193:30303,enode://2da52288522812dd69e33ea3c601a075e567a28e3eafeacd476e8523d8538815279d1e545d62a3530bbf072c3a55ae4ca4c43580976bd1b53d679c0500f9524c@38.49.212.92:30303,enode://0fe58e6c092df18d290eef06f5535cde4507700038d9af2870f6e5d442a8418b7fdd4f0096e44d1bfa024afbcad3819fee0920ba4e0b8e37621463100662e5ee@38.102.84.166:30303

# =============================================================================
# NODE CONFIGURATION
# =============================================================================

# Sync mode: full (recommended for RPC)
SYNC_MODE=full

# Garbage collection mode: full (pruning enabled), archive (no pruning)
GC_MODE=full

# Additional XDC command-line arguments (optional)
# Use this to customize RPC settings or enable features
# Example: EXTRA_ARGS=--http.api eth,net,web3,XDPoS,debug
EXTRA_ARGS=

# =============================================================================
# PORTS
# =============================================================================
# RPC is enabled by default on 0.0.0.0:8545 with API: eth,net,web3,XDPoS
# WebSocket is disabled by default (enable via EXTRA_ARGS if needed)
# For public access, use Traefik with middleware (see ext-network.yml)

# P2P port (XDC default: 30303)
P2P_PORT=30303

# RPC HTTP port (default: 8545)
RPC_PORT=8545

# RPC WebSocket port (default: 8546)
WS_PORT=8546

# =============================================================================
# LOGGING
# =============================================================================

# Log level: 1=error, 2=warn, 3=info, 4=debug, 5=trace
LOG_LEVEL=3

# =============================================================================
# TRAEFIK/PROMETHEUS INTEGRATION
# =============================================================================

# External Docker network name for reverse proxy / monitoring
DOCKER_EXT_NETWORK=traefik_default

# Secure web proxy hostnames (used with Traefik labels)
DOMAIN=example.com
RPC_HOST=xdc
RPC_LB=xdc-lb
WS_HOST=xdcws
WS_LB=xdcws-lb

# =============================================================================
# VERSION PINNING
# =============================================================================

# Pin this repo to a specific git tag (leave empty for latest main)
SCRIPT_TAG=

# Environment version - increment when adding/renaming variables
ENV_VERSION=1